# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Defaults to gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# MongoDB connection string (Atlas: Connect → Drivers).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rumbodia?retryWrites=true&w=majority

# Optional. Database name. Defaults to the one in MONGO_URI, or "rumbodia" if the URI has none.
# MONGODB_DB=rumbodia

# Clerk keys: Clerk Dashboard → API keys. The secret key is server-only, never expose it to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

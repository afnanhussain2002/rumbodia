# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Defaults to gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# MongoDB connection string (Atlas: Connect → Drivers).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rumbodia?retryWrites=true&w=majority

# Optional. Database name. Defaults to the one in MONGO_URI, or "rumbodia" if the URI has none.
# MONGODB_DB=rumbodia

# Clerk keys: Clerk Dashboard → API keys. The secret key is server-only, never expose it to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Stripe: Dashboard → Developers → API keys. Then run `npm run stripe:setup` once to create the plans and the BLACKFRIDAY code.
STRIPE_SECRET_KEY=sk_live_...
# Not used by the app today (checkout happens on Stripe's page). Kept for reference.
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Dashboard → Developers → Webhooks → add https://<your-domain>/api/stripe/webhook, then copy its signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of the site, used for Stripe's return links. Falls back to the request's own URL.
APP_URL=https://your-domain.com
